{
  "version": 1,
  "node_types": [
    {"type": "clown-plugin-v1", "layer": "catalog", "id": "the clown plugin name", "fields": []},
    {"type": "mcp-server-v1", "layer": "catalog", "id": "the MCP server name inside the plugin (moxy: the child server; moxy for moxy's own resources)", "fields": []},
    {"type": "mcp-tool-v1", "layer": "catalog", "id": "the tool name as its server's manifest spells it, verbatim", "fields": ["kind", "perm", "async", "impure"]},
    {"type": "just-recipe-v1", "layer": "catalog", "id": "the recipe namepath verbatim", "fields": ["group"]},
    {"type": "recipe-arg-v1", "layer": "instance", "id": "the recipe's parameter name at that position", "fields": ["position", "value"]},
    {"type": "tool-input-v1", "layer": "instance", "id": "the input field's name", "fields": ["field", "value"]},
    {"type": "fs-path-v1", "layer": "instance", "id": "a file: id: home-relative under home, absolute elsewhere, canonical", "fields": ["field"]},
    {"type": "mcp-resources-v1", "layer": "catalog", "id": "resources", "fields": ["op"]},
    {"type": "mcp-resource-v1", "layer": "instance", "id": "the canonical resource URI", "fields": ["op"]},
    {"type": "cg-root-v1", "layer": "instance", "id": "the root as cutting-garden's roots listing spells it", "fields": ["op", "scheme"]},
    {"type": "cg-field-v1", "layer": "instance", "id": "the field's name", "fields": ["field", "value", "op"]}
  ],
  "schemes": [
    {"scheme": "madder", "plugin": "moxy", "server": "moxy"},
    {"scheme": "chrest", "plugin": "moxy", "server": "chrest"},
    {"scheme": "nebulous", "plugin": "moxy", "server": "nebulous"},
    {"scheme": "clown", "plugin": "clown-builtin-diagnostics", "server": "disconnects"},
    {"scheme": "caldav", "plugin": "cutting-garden", "server": "cutting-garden"},
    {"scheme": "ynab", "plugin": "cutting-garden", "server": "cutting-garden"},
    {"scheme": "smith", "plugin": "cutting-garden", "server": "cutting-garden"},
    {"scheme": "org", "plugin": "cutting-garden", "server": "cutting-garden"},
    {"scheme": "newsblur", "plugin": "cutting-garden", "server": "cutting-garden"},
    {"scheme": "fastmail", "plugin": "cutting-garden", "server": "cutting-garden"},
    {"scheme": "bookmark", "plugin": "cutting-garden", "server": "cutting-garden"}
  ],
  "tools": [
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "Read", "kind": "read",
     "fields": [{"name": "file_path", "kind": "path"}]},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "Edit", "kind": "write",
     "fields": [{"name": "file_path", "kind": "path"}]},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "Write", "kind": "write",
     "fields": [{"name": "file_path", "kind": "path"}]},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "NotebookEdit", "kind": "write",
     "fields": [{"name": "notebook_path", "kind": "path"}]},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "Glob", "kind": "read",
     "fields": [{"name": "path", "kind": "path", "resolve": "cwd"}],
     "note": "pattern is input; the enforcer refuses an absolute pattern or one with a .. segment (RFC 0018 §7)"},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "Grep", "kind": "read",
     "fields": [{"name": "path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "Bash", "kind": "exec",
     "note": "command is one opaque input value; admitting it open admits every path (RFC 0019 W-1)"},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "Agent", "kind": "exec"},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "Skill", "kind": "exec"},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "WebFetch", "kind": "read",
     "note": "url is input: no catalog server owns http(s)"},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "WebSearch", "kind": "read"},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "ReadMcpResourceTool", "kind": "read",
     "presents": "owner-resource-read",
     "fields": [{"name": "uri", "kind": "reference", "op": "read"}, {"name": "server", "kind": "route"}]},
    {"plugin": "clown-builtin-harness", "server": "harness", "tool": "ListMcpResourcesTool", "kind": "read",
     "presents": "owner-resource-read",
     "fields": [{"name": "server", "kind": "route"}]},

    {"plugin": "moxy", "server": "moxy", "tool": "async", "presents": "wrapped-call",
     "fields": [{"name": "tool", "kind": "route"}, {"name": "args", "kind": "route"}, {"name": "timeout", "kind": "route"}]},
    {"plugin": "moxy", "server": "moxy", "tool": "batch", "presents": "wrapped-call",
     "fields": [{"name": "calls", "kind": "route"}, {"name": "on_error", "kind": "route"}, {"name": "async", "kind": "route"}]},

    {"plugin": "moxy", "server": "folio", "tool": "read", "fields": [{"name": "file_path", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "write", "fields": [{"name": "file_path", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "ls", "fields": [{"name": "path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "folio", "tool": "glob", "fields": [{"name": "path", "kind": "path", "resolve": "cwd"}],
     "note": "pattern is input; the enforcer refuses an absolute pattern or one with a .. segment (RFC 0018 §7)"},
    {"plugin": "moxy", "server": "folio", "tool": "tree", "fields": [{"name": "path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "folio", "tool": "df", "fields": [{"name": "path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "folio", "tool": "du", "fields": [{"name": "path", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "file-type", "fields": [{"name": "path", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "tar", "fields": [{"name": "path", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "mkdir", "fields": [{"name": "path", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "chmod", "fields": [{"name": "path", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "rm", "fields": [{"name": "paths", "kind": "path", "split": "whitespace"}]},
    {"plugin": "moxy", "server": "folio", "tool": "cp",
     "fields": [{"name": "source", "kind": "path"}, {"name": "destination", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "mv",
     "fields": [{"name": "source", "kind": "path"}, {"name": "destination", "kind": "path"}]},
    {"plugin": "moxy", "server": "folio", "tool": "link",
     "fields": [{"name": "source", "kind": "path"}, {"name": "target", "kind": "path"}]},

    {"plugin": "moxy", "server": "rg", "tool": "search", "fields": [{"name": "path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "jq", "tool": "jq",
     "fields": [{"name": "files", "kind": "path"}, {"name": "cwd", "kind": "path", "resolve": "cwd"}, {"name": "stdin", "kind": "content"}]},
    {"plugin": "moxy", "server": "toolbox", "tool": "run",
     "fields": [{"name": "stdin", "kind": "content"}],
     "note": "command names file operands toolbox reads; it is one opaque input value, like Bash's"},
    {"plugin": "moxy", "server": "env", "tool": "resolve", "fields": [{"name": "path", "kind": "path"}]},

    {"plugin": "moxy", "server": "grit", "tool": "status", "fields": [{"name": "paths", "kind": "path", "relative_to": "repo-root"}]},
    {"plugin": "moxy", "server": "grit", "tool": "diff", "fields": [{"name": "paths", "kind": "path", "relative_to": "repo-root"}]},
    {"plugin": "moxy", "server": "grit", "tool": "log", "fields": [{"name": "paths", "kind": "path", "relative_to": "repo-root"}]},
    {"plugin": "moxy", "server": "grit", "tool": "branch",
     "fields": [{"name": "repo_path", "kind": "path", "resolve": "cwd"}, {"name": "paths", "kind": "path", "relative_to": "repo_path"}]},
    {"plugin": "moxy", "server": "grit", "tool": "stage",
     "fields": [{"name": "repo_path", "kind": "path", "resolve": "cwd"}, {"name": "paths", "kind": "path", "relative_to": "repo_path"}]},
    {"plugin": "moxy", "server": "grit", "tool": "stash",
     "fields": [{"name": "repo_path", "kind": "path", "resolve": "cwd"}, {"name": "paths", "kind": "path", "relative_to": "repo_path"}]},
    {"plugin": "moxy", "server": "grit", "tool": "commit", "fields": [{"name": "repo_path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "grit", "tool": "merge", "fields": [{"name": "repo_path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "grit", "tool": "remote", "fields": [{"name": "repo_path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "grit", "tool": "tag", "fields": [{"name": "repo_path", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "grit", "tool": "worktree",
     "fields": [{"name": "repo_path", "kind": "path", "resolve": "cwd"}, {"name": "path", "kind": "path"}]},
    {"plugin": "moxy", "server": "grit", "tool": "clone",
     "fields": [{"name": "source", "kind": "path"}, {"name": "destination", "kind": "path"}]},

    {"plugin": "moxy", "server": "chix", "tool": "build", "fields": [{"name": "flake_dir", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "chix", "tool": "develop-run", "fields": [{"name": "flake_dir", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "chix", "tool": "flake-check", "fields": [{"name": "flake_dir", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "chix", "tool": "flake-init", "fields": [{"name": "flake_dir", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "chix", "tool": "flake-lock", "fields": [{"name": "flake_dir", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "chix", "tool": "flake-update", "fields": [{"name": "flake_dir", "kind": "path", "resolve": "cwd"}]},
    {"plugin": "moxy", "server": "chix", "tool": "nix-hash", "fields": [{"name": "path", "kind": "path"}]},
    {"plugin": "moxy", "server": "chix", "tool": "store-cat", "fields": [{"name": "path", "kind": "path"}]},
    {"plugin": "moxy", "server": "chix", "tool": "store-ls", "fields": [{"name": "path", "kind": "path"}]},

    {"plugin": "moxy", "server": "piers", "tool": "create",
     "fields": [{"name": "content_path", "kind": "path"}, {"name": "base_dir", "kind": "path"}]},
    {"plugin": "moxy", "server": "piers", "tool": "update",
     "fields": [{"name": "content_path", "kind": "path"}, {"name": "base_dir", "kind": "path"}]},

    {"plugin": "moxy", "server": "chrest", "tool": "read-resource", "fields": [{"name": "uri", "kind": "reference", "op": "read"}]},
    {"plugin": "moxy", "server": "chrest", "tool": "resource-read", "fields": [{"name": "uri", "kind": "reference", "op": "read"}]},
    {"plugin": "moxy", "server": "nebulous", "tool": "resource-read", "fields": [{"name": "uri", "kind": "reference", "op": "read"}]},

    {"plugin": "moxy", "server": "smith", "tool": "issue-list",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "issue-get",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "issue-create",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "issue-comment",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "issue-close",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "issue-edit",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "issue-edit-labels",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "issue-wait", "fields": [{"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "issue-watch", "fields": [{"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "pr-list",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "pr-get",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "pr-create",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "pr-comment",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "pr-merge",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "pr-status",
     "fields": [{"name": "repo", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "repo-get",
     "fields": [{"name": "name", "kind": "input", "resolve": "cwd-remote"}, {"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "content-get", "fields": [{"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "api-get", "fields": [{"name": "host", "kind": "input", "resolve": "cwd-remote"}]},
    {"plugin": "moxy", "server": "smith", "tool": "whoami", "fields": [{"name": "host", "kind": "input", "resolve": "cwd-remote"}]},

    {"plugin": "cutting-garden", "server": "cutting-garden", "tool": "list_nodes", "fields": [{"name": "uri", "kind": "reference", "op": "read"}]},
    {"plugin": "cutting-garden", "server": "cutting-garden", "tool": "read_node", "fields": [{"name": "uri", "kind": "reference", "op": "read"}]},
    {"plugin": "cutting-garden", "server": "cutting-garden", "tool": "read_facets", "fields": [{"name": "uri", "kind": "reference", "op": "read"}]},
    {"plugin": "cutting-garden", "server": "cutting-garden", "tool": "mutate_nodes",
     "fields": [{"name": "groups", "kind": "reference", "op": "from-body"}],
     "note": "one resource path per op (anchor + id; create: the in container plus a New step; patch/put: one cg-field-v1 step per body field; sweep: one path per matched node)"},

    {"plugin": "just-us", "server": "just-us", "tool": "run_recipe",
     "fields": [{"name": "recipe", "kind": "recipe"}, {"name": "args", "kind": "recipe"}],
     "note": "the recipe is a value path under the tool (recipe step, then one recipe-arg-v1 step per argument); timeout, async and impure are tool-input-v1 siblings of it (RFC 0018 §1)"},

    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_branch",
     "fields": [{"name": "repo_path", "kind": "path", "resolve": "session-worktree"}, {"name": "paths", "kind": "path", "relative_to": "repo_path"}]},
    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_stage",
     "fields": [{"name": "repo_path", "kind": "path", "resolve": "session-worktree"}, {"name": "paths", "kind": "path", "relative_to": "repo_path"}]},
    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_stash",
     "fields": [{"name": "repo_path", "kind": "path", "resolve": "session-worktree"}, {"name": "paths", "kind": "path", "relative_to": "repo_path"}]},
    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_commit", "fields": [{"name": "repo_path", "kind": "path", "resolve": "session-worktree"}]},
    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_merge", "fields": [{"name": "repo_path", "kind": "path", "resolve": "session-worktree"}]},
    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_remote", "fields": [{"name": "repo_path", "kind": "path", "resolve": "session-worktree"}]},
    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_tag", "fields": [{"name": "repo_path", "kind": "path", "resolve": "session-worktree"}]},
    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_worktree",
     "fields": [{"name": "repo_path", "kind": "path", "resolve": "session-worktree"}, {"name": "path", "kind": "path"}]},
    {"plugin": "spinclass", "server": "spinclass", "tool": "grit_clone", "fields": [{"name": "destination", "kind": "path"}]}
  ]
}
