# A read-only reviewer: reads files, searches, reads git history and the forge,
# changes nothing. An example for a worker or juggler unit's moxyfile, not
# installed anywhere. Measured with `just debug-moxy-heap "" 1 idle no
# docs/examples/reviewer.moxyfile` (the tools it serves are listed).
#
# allow-tools is the fail-closed list, enforced in the proxy at list and at
# call: a bare entry allows a whole server, `server.tool` one tool. Anything
# not named here is neither listed nor callable. See moxyfile(5) NARROWING.
allow-tools = [
  "folio.read",
  "folio.glob",
  "folio.ls",
  "folio.tree",
  "folio.file-type",
  "folio.du",
  "folio.df",
  "rg",
  "jq",
  "man",
  "toolbox",
  "grit.status",
  "grit.diff",
  "grit.log",
  "grit.rev-parse",
  "grit.worktree-list",
  "smith.issue-get",
  "smith.issue-list",
  "smith.pr-get",
  "smith.pr-list",
  "smith.pr-status",
  "smith.content-get",
]

# A [[servers]] child the reviewer has no allowed tool of is not spawned on a
# moxy that has the allow-tools skip (moxy#525); on an older moxy list it here
# instead, e.g. disable-servers = ["chrest", "issue-filer"].
#
# allow-tools filters tools; it never skips a moxin, and only [[servers]]
# children are skipped when it leaves them nothing. To not serve a moxin at
# all, list it in disable-moxins (startup logs "skipping moxin ... disabled by
# moxyfile"). That does not save memory: moxins are discovered and parsed
# in-process before the list applies (about 4.7 MB; only builtin-native =
# false avoids it, and that removes folio/rg too).
#
# Names in allow-tools and disable-moxins are the dotted canonical form
# (folio.read, man.semantic-search), not the underscore form a client may
# display (folio_read). An underscored name is a bare server name to the
# parser, so it names no tool that moxy serves.
#
# For a unit a spawner hands this file to, set MOXY_PARENT_MOXYFILE to the
# spawner's own moxyfile so moxy refuses to serve one that widens it (FDR 0013;
# `moxy narrows --parent P --child C` checks it offline).
