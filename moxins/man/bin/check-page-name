#!/usr/bin/env bash
# Validate the page name man's always-allow tools hand to man(1) (moxy#495).
# man treats an argument containing a slash as a file to format, and one
# starting with a dash as an option; so only a page name is accepted: a letter,
# digit or underscore first, then letters, digits and ._+@:-, optionally a
# (section) suffix like (1) or (3p). No slash, no "..", no NUL, no control
# character, at most 128 characters before the suffix.
# Prints the name on success; exits 2 otherwise.
set -euo pipefail

name="${1-}"
re='^[A-Za-z0-9_][A-Za-z0-9_.+@:-]{0,127}(\([0-9][A-Za-z0-9]{0,3}\))?$'
if [[ ! $name =~ $re ]] || [[ $name == *..* ]]; then
  echo "man: '${name:0:100}' is not a manual page name (letters, digits and ._+@:- with an optional (section); no slash, no '..')" >&2
  exit 2
fi
printf '%s\n' "$name"
