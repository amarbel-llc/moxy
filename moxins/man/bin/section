#!/usr/bin/env bash
set -euo pipefail

page="$1"; section_name="$2"
src=$(man -w "$page" 2>/dev/null) || true
src="${src%%$'\n'*}"

[ -z "$src" ] && { echo "No manual entry for $page"; exit 1; }
raw=$(case "$src" in
  *.gz) gzip -dc "$src" ;;
  *)    cat "$src" ;;
esac)
# Extract a section by name from raw roff source.
# Handles both mdoc(7) (.Sh/.Ss) and man(7) (.SH/.SS) macros at any heading level.
# The requested title travels via the environment, not `awk -v`: -v processes
# backslash escapes, which mangles roff-escaped titles (moxy#446). Both the
# requested title and each roff heading are normalised to one form (roff
# escapes for hyphen/arrow/zero-width resolved, case folded) before comparing.
result=$(SECTION_TARGET="$section_name" awk '
function norm(s) {
  gsub(/\\-/, "-", s)
  gsub(/\\\(->/, "→", s)
  gsub(/\\&/, "", s)
  return tolower(s)
}
BEGIN { found=0; IGNORECASE=1; target = norm(ENVIRON["SECTION_TARGET"]) }
/^\.(Sh|SH|Ss|SS) / {
  if (found) exit
  name = $0; sub(/^\.(Sh|SH|Ss|SS) /, "", name)
  gsub(/^"|"$/, "", name)
  if (norm(name) == target) found=1
}
found { print }
' <<< "$raw") || true
if [ -z "$result" ]; then
  echo "Section \"$section_name\" not found in $page. Available sections:"
  awk '/^\.(Sh|SH) /{sub(/^\.(Sh|SH) /,""); gsub(/^"|"$/,""); print "  "$0}
       /^\.(Ss|SS) /{sub(/^\.(Ss|SS) /,""); gsub(/^"|"$/,""); print "    "$0}' <<< "$raw"
  exit 1
fi
echo "$result"
