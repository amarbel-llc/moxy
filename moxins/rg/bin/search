#!/usr/bin/env bash
set -euo pipefail
pattern="$1"
path="${2:-.}"
glob="${3:-}"
filetype="${4:-}"
output_mode="${5:-files_with_matches}"
context="${6:-}"
case_insensitive="${7:-}"
multiline="${8:-}"
hidden="${9:-}"
max_columns="${10:-500}"

rg_args=()

case "$output_mode" in
  files_with_matches) rg_args+=(-l) ;;
  count)              rg_args+=(-c) ;;
  content)            rg_args+=(-n) ;;
  *) echo "Unknown output_mode: $output_mode" >&2; exit 1 ;;
esac

# Split a glob string on top-level commas (commas outside {...}) so the
# intuitive comma form `*.sh,*.bash` becomes multiple --glob args, while a
# brace glob `*.{sh,bash}` is preserved as a single glob. See #289.
if [ -n "$glob" ]; then
  depth=0
  piece=""
  for (( i=0; i<${#glob}; i++ )); do
    ch="${glob:i:1}"
    case "$ch" in
      '{')
        depth=$((depth + 1))
        piece+="$ch"
        ;;
      '}')
        if [ "$depth" -gt 0 ]; then
          depth=$((depth - 1))
        fi
        piece+="$ch"
        ;;
      ',')
        if [ "$depth" -eq 0 ]; then
          if [ -n "$piece" ]; then
            rg_args+=(--glob "$piece")
          fi
          piece=""
        else
          piece+="$ch"
        fi
        ;;
      *) piece+="$ch" ;;
    esac
  done
  if [ -n "$piece" ]; then
    rg_args+=(--glob "$piece")
  fi
fi

[ -n "$filetype" ] && rg_args+=(--type "$filetype")

[ -n "$context" ] && rg_args+=(-C "$context")

# Cap per-line output bytes so a single physical long line (e.g. a wrapped /
# pretty-printed JSON blob searched as one line) can't blow past the token
# budget regardless of match count (#197). --max-columns-preview keeps a
# truncated prefix plus a "[... N omitted]" marker so the hit stays visible and
# the agent knows to narrow. Only meaningful in content mode (the other modes
# emit paths/counts, not lines); max_columns=0 disables the cap (rg's
# unlimited sentinel).
if [ "$output_mode" = "content" ] && [ "$max_columns" != "0" ]; then
  rg_args+=(--max-columns "$max_columns" --max-columns-preview)
fi

[ "$case_insensitive" = "true" ] && rg_args+=(-i)

[ "$multiline" = "true" ] && rg_args+=(-U --multiline-dotall)

# --hidden searches dotfiles/dot-directories (e.g. .github/) that ripgrep
# skips by default. .gitignore is still honored, so .git/ stays excluded.
# See #285.
[ "$hidden" = "true" ] && rg_args+=(--hidden)

# ripgrep exit codes: 0 = match, 1 = no match (clean), 2 = error. Capture
# combined stdout+stderr and branch on the exit code so a real error (bad
# regex, unrecognized --type, unreadable path) is surfaced as a tool error
# (non-zero exit -> isError result) instead of being swallowed and read as an
# empty "no matches" success. See #296. On a clean run rg writes nothing to
# stderr, so the combined capture holds only matches.
set +e
# A cached blob arrives as /dev/fd/N, a pipe that rg skips as a path (#469):
# search its content on stdin instead.
#
# readguard (#490) opens the path itself: a directory is entered and arrives
# as ".", a file as a /dev/fd/N regular file. It says which through
# READGUARD_ORIG (the caller's name) and READGUARD_REPL (what rg will print in
# its place); rg's output is mapped back to the caller's name below.
case "$path" in
  /dev/fd/*)
    if [ -n "${READGUARD_ORIG:-}" ] && [ "${READGUARD_REPL:-}" = "$path" ]; then
      output=$(rg "${rg_args[@]}" -- "$pattern" "$path" 2>&1)
    else
      output=$(rg "${rg_args[@]}" -- "$pattern" <"$path" 2>&1)
    fi
    rc=$?
    ;;
  *)
    output=$(rg "${rg_args[@]}" -- "$pattern" "$path" 2>&1)
    rc=$?
    ;;
esac
set -e

if [ -n "${READGUARD_ORIG:-}" ] && [ "${READGUARD_REPL:-}" != "$READGUARD_ORIG" ] && [ -n "$output" ]; then
  orig="$READGUARD_ORIG"
  if [ "$READGUARD_REPL" = "./" ]; then
    # an entered directory: rg printed ./x for what the caller named dir/x
    orig="${orig%/}/"
  fi
  output=$(printf '%s\n' "$output" | awk -v repl="$READGUARD_REPL" -v orig="$orig" '
    index($0, repl) == 1 { $0 = orig substr($0, length(repl) + 1) }
    { print }')
fi

case "$rc" in
  0|1)
    # Match (0) or clean no-match (1). Empty output is a genuine absence.
    printf '%s\n' "$output"
    ;;
  *)
    # rg reported an error; surface it.
    printf '%s\n' "${output:-rg exited with status $rc}" >&2
    exit "$rc"
    ;;
esac
