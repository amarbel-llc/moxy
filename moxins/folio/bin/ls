#!/usr/bin/env bash
set -euo pipefail
dir="${1:-.}"
flags="${2:-}"

if [ ! -d "$dir" ]; then
  echo "not a directory: $dir" >&2
  exit 1
fi

# The permission check judges `path` alone (#532), so every word of `flags`
# must be a listed option: no operand, nothing that follows links (-L, -H,
# --dereference*), and no abbreviated long option. Split without globbing.
words=()
read -r -d '' -a words <<<"$flags" || true
short='^-[1aAbBcCdfFghGiklmnNopqQrRsStuUvxXZ]+$'
long='^--(all|almost-all|classify|directory|escape|full-time|group-directories-first|human-readable|inode|literal|no-group|numeric-uid-gid|recursive|reverse|si|size|color(=[a-z]+)?|(sort|time)=[a-z]+|time-style=[^[:space:]]+|block-size=([0-9]+|[0-9]*[KMGTPE](i?B)?)|(hide|ignore)=[^[:space:]]+)$'
for word in "${words[@]}"; do
  if ! [[ $word =~ $short || $word =~ $long ]]; then
    echo "ERROR: ls flag not allowed: '$word'. flags takes display options only (no paths, no link following); name the directory in path." >&2
    exit 2
  fi
done

if [ ${#words[@]} -gt 0 ]; then
  # readguard (#490) enters the directory and passes "."; map the headers
  # back to the name the caller gave
  text=$(ls "${words[@]}" -- "$dir" | { if [ -n "${READGUARD_MAP:-}" ]; then "$READGUARD_MAP" map; else cat; fi; })
  mime="text/plain"
else
  first=true
  text="["
  for entry in "$dir"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name=$(basename "$entry")

    if [ -L "$entry" ]; then
      type="symlink"
    elif [ -d "$entry" ]; then
      type="directory"
    else
      type="file"
    fi

    $first || text+=","
    first=false

    if [ "$type" = "file" ]; then
      size=$(stat -c '%s' "$entry")
      text+=$(printf '\n  {"name": %s, "type": "%s", "size": %s}' "$(printf '%s' "$name" | jq -Rs .)" "$type" "$size")
    else
      text+=$(printf '\n  {"name": %s, "type": "%s"}' "$(printf '%s' "$name" | jq -Rs .)" "$type")
    fi
  done
  text+=$'\n]'
  mime="application/json"
fi

# Feed the listing via stdin: passing it as an argv argument breaks on
# listings larger than Linux's per-arg exec limit (MAX_ARG_STRLEN, #342).
printf '%s' "$text" | jq -Rsc --arg mime "$mime" \
  '{content:[{type:"text",text:.,mimeType:$mime}]}'
