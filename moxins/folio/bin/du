#!/usr/bin/env bash
set -euo pipefail
path="$1"
flags="${2:-}"

if [ ! -e "$path" ] && [ ! -L "$path" ]; then
  echo "no such file or directory: $path" >&2
  exit 1
fi

# readguard (#490) may have opened the path for us: a directory arrives as "."
# and a file as /dev/fd/N (a link to the file, hence -D); READGUARD_ORIG is the
# name the caller gave, and `$READGUARD_MAP map` maps du's own output back to it.
shown="${READGUARD_ORIG:-$path}"
mapback() { if [ -n "${READGUARD_MAP:-}" ]; then "$READGUARD_MAP" map; else cat; fi; }

if [ -n "$flags" ]; then
  text=$(du -D $flags -- "$path" | mapback)
  mime="text/plain"
else
  bytes=$(du -sx -D --bytes -- "$path" | awk 'END {print $1}')
  human=$(du -shx -D -- "$path" | awk 'END {print $1}')
  text=$(jq -cn --arg path "$shown" --argjson bytes "$bytes" --arg human "$human" \
    '{path: $path, bytes: $bytes, human: $human}')
  mime="application/json"
fi

jq -cn --arg text "$text" --arg mime "$mime" \
  '{content:[{type:"text",text:$text,mimeType:$mime}]}'
