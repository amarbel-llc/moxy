#!/usr/bin/env bash
set -euo pipefail
path="$1"
flags="${2:-}"

if [ ! -e "$path" ] && [ ! -L "$path" ]; then
  echo "no such file or directory: $path" >&2
  exit 1
fi

# readguard (#490) may have opened the path for us: a directory arrives as "."
# and a file as /dev/fd/N (a link to the file, hence -D); READGUARD_ORIG is the
# name the caller gave, and `$READGUARD_MAP map` maps du's own output back to it.
shown="${READGUARD_ORIG:-$path}"
mapback() { if [ -n "${READGUARD_MAP:-}" ]; then "$READGUARD_MAP" map; else cat; fi; }

# The permission check judges `path` alone (#532), so every word of `flags`
# must be a listed option: no operand, nothing that follows links (-L), nothing
# that reads a file (-X, --exclude-from, --files0-from), and no abbreviated long
# option. Split without globbing.
words=()
read -r -d '' -a words <<<"$flags" || true
short='^-[0abchklmPsSx]+$'
depth='^-[0abchklmPsSx]*d([0-9]*)$'
long='^--(all|apparent-size|bytes|count-links|human-readable|inodes|no-dereference|null|one-file-system|separate-dirs|si|summarize|time|total|(block-size|max-depth|threshold)=-?[0-9]+[A-Za-z]*|time=[a-z]+|(time-style|exclude)=[^[:space:]]+)$'
want_depth=""
for word in "${words[@]}"; do
  if [ -n "$want_depth" ] && [[ $word =~ ^[0-9]+$ ]]; then
    want_depth=""
    continue
  fi
  if [ -z "$want_depth" ]; then
    if [[ $word =~ $short || $word =~ $long ]]; then
      continue
    fi
    if [[ $word =~ $depth ]]; then
      [ -n "${BASH_REMATCH[1]}" ] || want_depth=1
      continue
    fi
  fi
  echo "ERROR: du flag not allowed: '$word'. flags takes reporting options only (no paths, no link following, no file lists); name what to measure in path." >&2
  exit 2
done
if [ -n "$want_depth" ]; then
  echo "ERROR: du flag -d needs a number" >&2
  exit 2
fi

if [ ${#words[@]} -gt 0 ]; then
  text=$(du -D "${words[@]}" -- "$path" | mapback)
  mime="text/plain"
else
  bytes=$(du -sx -D --bytes -- "$path" | awk 'END {print $1}')
  human=$(du -shx -D -- "$path" | awk 'END {print $1}')
  text=$(jq -cn --arg path "$shown" --argjson bytes "$bytes" --arg human "$human" \
    '{path: $path, bytes: $bytes, human: $human}')
  mime="application/json"
fi

jq -cn --arg text "$text" --arg mime "$mime" \
  '{content:[{type:"text",text:$text,mimeType:$mime}]}'
