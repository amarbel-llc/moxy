#!/usr/bin/env bash
set -euo pipefail
path="$1"

if [ ! -e "$path" ]; then
  echo "Error: path does not exist: $path" >&2
  exit 1
fi

# A cached blob arrives as /dev/fd/N, a pipe: `file` would report the pipe,
# not the content (#469). Read the content from stdin instead.
case "$path" in
  /dev/fd/*)
    if [ "${READGUARD_REPL:-}" = "$path" ]; then
      # opened by readguard (#490): a regular file; its output is mapped back
      # to the name the caller gave
      file -L "$path"
    else
      file -b - <"$path"
    fi
    ;;
  *)
    file "$path"
    ;;
esac
