#!/usr/bin/env bash
set -euo pipefail
repo="${1:-}"
host="${2:-}"
include_prerelease="${3:-}"
include_draft="${4:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
smith_cmd+=(release list)
if [ "$include_prerelease" = "true" ]; then
  smith_cmd+=(-p)
fi
if [ "$include_draft" = "true" ]; then
  smith_cmd+=(-d)
fi
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=(-r "$repo")
fi
smith_run "$repo" "$host"
