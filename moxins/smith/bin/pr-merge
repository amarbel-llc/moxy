#!/usr/bin/env bash
set -euo pipefail
number="$1"
method="${2:-}"
delete_branch="${3:-false}"
title="${4:-}"
message="${5:-}"
repo="${6:-}"
host="${7:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

ref=$(qualify_ref "$number" "$repo")
smith_base "$host"
smith_cmd+=(pr merge)
if [ -n "$method" ]; then
  smith_cmd+=(-M "$method")
fi
if [ "$delete_branch" = "true" ]; then
  smith_cmd+=(-d)
fi
if [ -n "$title" ]; then
  smith_cmd+=(-t "$title")
fi
if [ -n "$message" ]; then
  # --message takes an optional value; the = form keeps clap from
  # swallowing the PR ref as the message.
  smith_cmd+=("--message=$message")
fi
smith_cmd+=("$ref")
smith_run "$repo" "$host"
