#!/usr/bin/env bash
# Shared helpers for smith bin scripts. Source this file.
#
# smith addresses issues and PRs with a qualified reference (OWNER/NAME#N) that
# works from any cwd; a bare number relies on smith resolving the repo from the
# cwd's git remotes. qualify_ref builds whichever form the repo arg implies.
# smith_base seeds the global `smith_cmd` array with `smith` plus the instance
# host flag when set; callers append subcommand words and exec "${smith_cmd[@]}".
#
# This is intentionally NOT set -e so callers control error handling.
# Named with a leading dot so wrapProgram's `bin/*` glob skips it —
# wrapProgram would otherwise exec-replace the sourced process.

validate_repo() {
  if [[ "$1" != */* ]]; then
    echo "ERROR: repo must be in OWNER/NAME format" >&2
    exit 2
  fi
}

qualify_ref() {
  local number="$1" repo="${2:-}"
  if [ -n "$repo" ]; then
    validate_repo "$repo"
    printf '%s#%s' "$repo" "$number"
  else
    printf '%s' "$number"
  fi
}

smith_base() {
  local host="${1:-}"
  smith_cmd=("${SMITH_BIN:-smith}")
  if [ -n "$host" ]; then
    smith_cmd+=(-H "$host")
  fi
}

# Lazily create (once per script run) a scratch directory outside any git
# repo, and clean it up on exit. Sets the global $_smith_scratch rather than
# printing the path via command substitution --- a `$(...)` subshell would
# run the `trap ... EXIT` below on its OWN exit (i.e. immediately after
# printing), deleting the directory before the caller ever cds into it.
_smith_scratch=""
_smith_scratch_dir() {
  if [ -z "$_smith_scratch" ]; then
    _smith_scratch=$(mktemp -d)
    trap 'rm -rf "$_smith_scratch"' EXIT
  fi
}

# smith_self_username: resolves the smith-authenticated user's bare username via
# the structured `api user` endpoint. Must be called after smith_base (uses
# the global smith_cmd array). Deliberately NOT `smith whoami` --- that prints a
# free-text "currently signed in to <login>@<host>" line with no reliable
# delimiter between the login and the host, so scraping it (e.g. an awk
# last-field grab) can yield the whole login@host token instead of a bare
# login. Echoes empty string on any failure (missing auth, network, etc.).
smith_self_username() {
  _smith_scratch_dir
  (cd "$_smith_scratch" && "${smith_cmd[@]}" api user 2>/dev/null | jq -r '.username // empty') || true
}

# smith_run <repo> <host> [extra smith_cmd args...]
# Execs smith_cmd (plus any trailing args), redirecting smith's cwd to a scratch
# dir when repo AND host are both already resolved explicitly --- smith's
# RepoInfo::get_current (repo.rs) unconditionally inspects the cwd's git
# remote via git2::Repository::discover(".") and crashes ("repo url too
# short") on remotes with a single path segment (e.g. this forge's
# owner-less "max-canonical" clone URLs), even when the remote is never
# actually needed because repo+host were given explicitly
# (amarbel-llc/moxy#398). When either is omitted, the caller is relying on
# cwd auto-resolution, so run from the real cwd unchanged.
smith_run() {
  local repo="$1" host="$2"
  shift 2
  if [ -n "$repo" ] && [ -n "$host" ]; then
    _smith_scratch_dir
    (cd "$_smith_scratch" && "${smith_cmd[@]}" "$@")
  else
    "${smith_cmd[@]}" "$@"
  fi
}

# run_subscribe <number> <unsubscribe> <repo> <host>
# Subscribes (or, if unsubscribe="true", unsubscribes) the smith-authenticated
# user to/from an issue or PR's notifications, via smith api's raw REST
# passthrough (#414) against Forgejo's GitHub-compatible subscriptions
# endpoint — smith has no native subscribe subcommand. Issues and PRs share the
# same underlying repos/OWNER/NAME/issues/N/subscriptions endpoint in
# Forgejo's API (PRs are issues internally, verified live), so issue-watch
# and pr-watch both call this. repo is REQUIRED: smith api has no cwd-remote
# auto-resolution (same constraint as content-get, #414).
run_subscribe() {
  local number="$1" unsubscribe="${2:-}" repo="${3:-}" host="${4:-}"

  if [ -z "$repo" ]; then
    echo "ERROR: repo is required (smith api has no cwd auto-resolution)" >&2
    exit 2
  fi
  validate_repo "$repo"

  smith_base "$host"
  local self
  self=$(smith_self_username)
  if [ -z "$self" ]; then
    echo "ERROR: could not determine authenticated user" >&2
    exit 1
  fi

  local method="PUT"
  [ "$unsubscribe" = "true" ] && method="DELETE"

  smith_cmd+=(api "repos/$repo/issues/$number/subscriptions/$self" -X "$method")
  smith_run "$repo" "$host"
}

# run_smith_search <issue|pr> <query> <state> <labels> <creator> <assignee> <repo> <host>
# `smith issue search` and `smith pr search` share their whole flag surface; this
# threads the common filter args for both issue-list and pr-list.
run_smith_search() {
  local kind="$1" query="${2:-}" state="${3:-}" labels="${4:-}"
  local creator="${5:-}" assignee="${6:-}" repo="${7:-}" host="${8:-}"

  smith_base "$host"
  smith_cmd+=("$kind" search)
  if [ -n "$state" ]; then
    smith_cmd+=(-s "$state")
  fi
  if [ -n "$labels" ]; then
    smith_cmd+=(-l "$labels")
  fi
  if [ -n "$creator" ]; then
    smith_cmd+=(-c "$creator")
  fi
  if [ -n "$assignee" ]; then
    smith_cmd+=(-a "$assignee")
  fi
  if [ -n "$repo" ]; then
    validate_repo "$repo"
    smith_cmd+=(-r "$repo")
  fi
  if [ -n "$query" ]; then
    smith_cmd+=("$query")
  fi
  smith_run "$repo" "$host"
}
