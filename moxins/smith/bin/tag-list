#!/usr/bin/env bash
set -euo pipefail
repo="${1:-}"
host="${2:-}"
page="${3:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
smith_cmd+=(tag list)
if [ -n "$page" ]; then
  smith_cmd+=(-p "$page")
fi
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=(-r "$repo")
fi
smith_run "$repo" "$host"
