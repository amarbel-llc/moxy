#!/usr/bin/env bash
set -euo pipefail
number="$1"
view="${2:-body}"
repo="${3:-}"
host="${4:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

case "$view" in
body | comments | labels | diff | files | commits) ;;
*)
  echo "ERROR: view must be one of body, comments, labels, diff, files, commits" >&2
  exit 2
  ;;
esac

ref=$(qualify_ref "$number" "$repo")
smith_base "$host"
smith_run "$repo" "$host" pr view "$ref" "$view"
