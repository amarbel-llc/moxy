#!/usr/bin/env bash
set -euo pipefail
title="$1"
body="${2:-}"
repo="${3:-}"
host="${4:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
# --no-template and an explicit --body (even empty) keep smith from opening an
# editor or an interactive template picker — moxy tools run headless.
smith_cmd+=(issue create --no-template --body "$body")
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=(-r "$repo")
fi
smith_cmd+=("$title")
smith_run "$repo" "$host"
