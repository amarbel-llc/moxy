#!/usr/bin/env bash
set -euo pipefail
title="${1:-}"
body="${2:-}"
base="${3:-}"
head="${4:-}"
autofill="${5:-false}"
repo="${6:-}"
host="${7:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
smith_cmd+=(pr create)
if [ -n "$base" ]; then
  smith_cmd+=(--base "$base")
fi
if [ -n "$head" ]; then
  smith_cmd+=(--head "$head")
fi
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=(-r "$repo")
fi
if [ "$autofill" = "true" ]; then
  smith_cmd+=(-A)
else
  if [ -z "$title" ]; then
    echo "ERROR: title is required unless autofill is true" >&2
    exit 2
  fi
  # An explicit --body (even empty) keeps smith from opening an editor —
  # moxy tools run headless.
  smith_cmd+=(--body "$body" "$title")
fi
smith_run "$repo" "$host"
