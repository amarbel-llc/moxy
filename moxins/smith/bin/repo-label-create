#!/usr/bin/env bash
set -euo pipefail
name="$1"
color="$2"
repo="${3:-}"
host="${4:-}"
description="${5:-}"
exclusive="${6:-}"
archived="${7:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
smith_cmd+=(repo labels)
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=("$repo")
fi
smith_cmd+=(create "$name" "$color")
if [ -n "$description" ]; then
  smith_cmd+=(--description="$description")
fi
if [ "$exclusive" = "true" ]; then
  smith_cmd+=(-e)
fi
if [ "$archived" = "true" ]; then
  smith_cmd+=(-a)
fi
smith_run "$repo" "$host"
