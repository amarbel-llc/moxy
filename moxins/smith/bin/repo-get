#!/usr/bin/env bash
set -euo pipefail
name="${1:-}"
host="${2:-}"
output_format="${3:-text}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

if [ "$output_format" = "json" ]; then
  if [ -z "$name" ]; then
    echo "ERROR: name is required when output_format=json (smith api has no cwd auto-resolution)" >&2
    exit 2
  fi
  validate_repo "$name"
  smith_base "$host"
  smith_cmd+=(api "repos/$name")
  smith_run "$name" "$host"
  exit 0
fi

smith_base "$host"
smith_cmd+=(repo view)
if [ -n "$name" ]; then
  validate_repo "$name"
  smith_cmd+=("$name")
fi
smith_run "$name" "$host"
