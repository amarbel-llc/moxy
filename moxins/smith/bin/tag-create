#!/usr/bin/env bash
set -euo pipefail
name="$1"
body="${2:-}"
branch="${3:-}"
repo="${4:-}"
host="${5:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
# --body= (even empty) keeps smith from opening an editor — moxy tools run
# headless. -b/--body is a clap optional-value flag, so use the = form.
smith_cmd+=(tag create "--body=$body")
if [ -n "$branch" ]; then
  smith_cmd+=(-B "$branch")
fi
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=(-r "$repo")
fi
smith_cmd+=("$name")
smith_run "$repo" "$host"
