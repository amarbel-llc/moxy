#!/usr/bin/env bash
set -euo pipefail
repo="${1:-}"
host="${2:-}"
archived="${3:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
smith_cmd+=(repo labels)
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=("$repo")
fi
smith_cmd+=(view)
if [ "$archived" = "true" ]; then
  smith_cmd+=(-a)
fi
smith_run "$repo" "$host"
