#!/usr/bin/env bash
set -euo pipefail
name="$1"
by_tag="${2:-}"
repo="${3:-}"
host="${4:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
smith_cmd+=(release delete)
if [ "$by_tag" = "true" ]; then
  smith_cmd+=(-t)
fi
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=(-r "$repo")
fi
smith_cmd+=("$name")
smith_run "$repo" "$host"
