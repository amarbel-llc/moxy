#!/usr/bin/env bash
set -euo pipefail
number="$1"
comment="${2:-}"
repo="${3:-}"
host="${4:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

ref=$(qualify_ref "$number" "$repo")
smith_base "$host"
smith_cmd+=(issue close)
if [ -n "$comment" ]; then
  # --with-msg takes an optional value; the = form keeps clap from
  # swallowing the issue ref as the message.
  smith_cmd+=("--with-msg=$comment")
fi
smith_cmd+=("$ref")
smith_run "$repo" "$host"
