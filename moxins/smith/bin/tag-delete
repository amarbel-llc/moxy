#!/usr/bin/env bash
set -euo pipefail
name="$1"
repo="${2:-}"
host="${3:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
smith_cmd+=(tag delete)
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=(-r "$repo")
fi
smith_cmd+=("$name")
smith_run "$repo" "$host"
