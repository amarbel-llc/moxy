#!/usr/bin/env bash
set -euo pipefail
name="$1"
tag="${2:-}"
create_tag="${3:-}"
body="${4:-}"
branch="${5:-}"
draft="${6:-}"
prerelease="${7:-}"
repo="${8:-}"
host="${9:-}"

# shellcheck source=bin/.smith-common
. "$(dirname "$0")/.smith-common"

smith_base "$host"
# --body= (even empty) keeps smith from opening an editor — moxy tools run
# headless. -b/--body is a clap optional-value flag, so use the = form.
smith_cmd+=(release create "--body=$body")
if [ -n "$tag" ]; then
  smith_cmd+=(-t "$tag")
fi
if [ -n "$create_tag" ]; then
  smith_cmd+=("--create-tag=$create_tag")
fi
if [ -n "$branch" ]; then
  smith_cmd+=(-B "$branch")
fi
if [ "$draft" = "true" ]; then
  smith_cmd+=(-d)
fi
if [ "$prerelease" = "true" ]; then
  smith_cmd+=(-p)
fi
if [ -n "$repo" ]; then
  validate_repo "$repo"
  smith_cmd+=(-r "$repo")
fi
smith_cmd+=("$name")
smith_run "$repo" "$host"
