#!/usr/bin/env bash
set -euo pipefail

# grit.stage is result-type = "mcp-result": every success path emits a single
# text-block MCP envelope via @BIN@/_emit. Error paths exit non-zero with a
# stderr message; mcp-result only shapes stdout on a zero exit.

subcommand="${1:-}"
paths_json="${2:-}"
intent_to_add="${3:-}"
force="${4:-}"
recursive="${5:-}"
source="${6:-}"
destination="${7:-}"
untracked="${8:-}"
ignored="${9:-}"
staged="${10:-}"
stat_only="${11:-}"
context_lines="${12:-}"
repo="${13:-.}"

cd "$repo"

read_paths() {
  # Populate the `files` array from the JSON paths arg.
  files=()
  if [ -n "$paths_json" ] && [ "$paths_json" != "null" ]; then
    while IFS= read -r p; do
      files+=("$p")
    done < <(printf '%s' "$paths_json" | jq -r '.[]')
  fi
}

case "$subcommand" in
  add)
    read_paths
    if [ "${#files[@]}" -eq 0 ]; then
      echo "stage add: paths is required" >&2
      exit 2
    fi
    git_args=(add)
    [ "$intent_to_add" = "true" ] && git_args+=(-N)
    git "${git_args[@]}" -- "${files[@]}"
    if [ "$intent_to_add" = "true" ]; then
      printf 'Recorded intent to add %d file(s)\n' "${#files[@]}"
    else
      printf 'Staged %d file(s)\n' "${#files[@]}"
    fi | "@BIN@/_emit"
    ;;
  unstage)
    read_paths
    if [ "${#files[@]}" -gt 0 ]; then
      git reset HEAD -- "${files[@]}"
    else
      git reset HEAD
    fi | "@BIN@/_emit"
    ;;
  rm)
    read_paths
    if [ "${#files[@]}" -eq 0 ]; then
      echo "stage rm: paths is required" >&2
      exit 2
    fi
    git_args=(rm)
    [ "$force" = "true" ] && git_args+=(-f)
    [ "$recursive" = "true" ] && git_args+=(-r)
    git_args+=(--)
    git_args+=("${files[@]}")
    git "${git_args[@]}" | "@BIN@/_emit"
    ;;
  mv)
    if [ -z "$source" ] || [ -z "$destination" ]; then
      echo "stage mv: source and destination are required" >&2
      exit 2
    fi
    mkdir -p "$(dirname "$destination")"
    git mv -- "$source" "$destination" | "@BIN@/_emit"
    ;;
  status)
    git_args=(status --short --branch)
    case "$untracked" in
      no|normal|all) git_args+=(--untracked-files="$untracked") ;;
      "") : ;;
      *) echo "untracked must be no|normal|all" >&2; exit 2 ;;
    esac
    [ "$ignored" = "true" ] && git_args+=(--ignored)
    if [ -n "$paths_json" ] && [ "$paths_json" != "null" ]; then
      git_args+=(--)
      while IFS= read -r p; do
        git_args+=("$p")
      done < <(printf '%s' "$paths_json" | jq -r '.[]')
    fi
    git "${git_args[@]}" | "@BIN@/_emit"
    ;;
  diff)
    # Index/working-tree diff: exec the shared bin/diff with the index-form
    # flags. No `ref` — comparing against another commit is a grit.branch diff.
    # bin/diff arg-order: ref paths staged stat_only context_lines repo_path.
    exec "@BIN@/diff" "" "$paths_json" "$staged" "$stat_only" "$context_lines" "$repo"
    ;;
  "")
    echo "stage: subcommand is required (add|unstage|rm|mv|status|diff)" >&2
    exit 2
    ;;
  *)
    echo "stage: unknown subcommand '$subcommand' (want add|unstage|rm|mv|status|diff)" >&2
    exit 2
    ;;
esac
