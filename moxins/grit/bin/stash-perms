#!/usr/bin/env bash
# Dynamic-perms gate for grit.stash.
# Receives: $1 = subcommand
#
# Exit codes (per moxy native dynamic-perms contract):
#   0 = allow
#   1 = ask
#   2 = deny
set -euo pipefail
subcommand="${1:-}"

case "$subcommand" in
  save|apply)
    echo "$subcommand is non-destructive — auto-allowed"
    exit 0
    ;;
  drop)
    echo "drop deletes a stash entry — confirmation required"
    exit 1
    ;;
  *)
    echo "unknown subcommand ($subcommand) — confirmation required"
    exit 1
    ;;
esac
