#!/usr/bin/env bash
# Dynamic-perms gate for grit.worktree.
# Receives: $1 = subcommand
#
# Exit codes (per moxy native dynamic-perms contract):
#   0 = allow
#   1 = ask
#   2 = deny
set -euo pipefail
subcommand="${1:-}"

case "$subcommand" in
  list)
    echo "list is read-only — auto-allowed"
    exit 0
    ;;
  remove)
    echo "remove deletes a worktree — confirmation required"
    exit 1
    ;;
  *)
    echo "unknown subcommand ($subcommand) — confirmation required"
    exit 1
    ;;
esac
