#!/usr/bin/env bash
# Dynamic-perms gate for grit.branch.
# Receives: $1 = subcommand
#
# Exit codes (per moxy native dynamic-perms contract):
#   0 = allow
#   1 = ask
#   2 = deny
set -euo pipefail
subcommand="${1:-}"

case "$subcommand" in
  create|checkout|log|rev-parse|diff)
    # Pointer-creation, branch switch, and the read-only inspect verbs.
    echo "$subcommand does not rewrite history — auto-allowed"
    exit 0
    ;;
  revert)
    # Appends new undo commits rather than rewriting history — auto-allowed.
    echo "revert appends new commits (no history rewrite) — auto-allowed"
    exit 0
    ;;
  delete)
    echo "delete removes a branch — confirmation required"
    exit 1
    ;;
  reset-soft)
    echo "reset-soft moves HEAD (changes preserved) — confirmation required"
    exit 1
    ;;
  reset-hard)
    echo "reset-hard moves HEAD and discards the working tree — confirmation required"
    exit 1
    ;;
  rebase|restack|cherry-pick)
    echo "$subcommand rewrites/replays commits — confirmation required"
    exit 1
    ;;
  *)
    echo "unknown subcommand ($subcommand) — confirmation required"
    exit 1
    ;;
esac
