#!/usr/bin/env bash
# Dynamic-perms gate for grit.stage.
# Receives: $1 = subcommand
#
# Exit codes (per moxy native dynamic-perms contract):
#   0 = allow
#   1 = ask
#   2 = deny
set -euo pipefail
subcommand="${1:-}"

case "$subcommand" in
  add|unstage|mv)
    echo "$subcommand does not delete working-tree files — auto-allowed"
    exit 0
    ;;
  rm)
    echo "rm deletes tracked files — confirmation required"
    exit 1
    ;;
  *)
    echo "unknown subcommand ($subcommand) — confirmation required"
    exit 1
    ;;
esac
