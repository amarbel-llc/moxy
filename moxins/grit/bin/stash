#!/usr/bin/env bash
set -euo pipefail

subcommand="${1:-}"
message="${2:-}"
include_untracked="${3:-}"
stash_ref="${4:-}"
paths_json="${5:-}"
repo="${6:-.}"

cd "$repo"

case "$subcommand" in
  save)
    git_args=(stash push)
    [ "$include_untracked" = "true" ] && git_args+=(-u)
    [ -n "$message" ] && git_args+=(-m "$message")
    if [ -n "$paths_json" ] && [ "$paths_json" != "null" ]; then
      files=()
      while IFS= read -r p; do
        [ -n "$p" ] && files+=("$p")
      done < <(printf '%s' "$paths_json" | jq -r '.[]')
      [ "${#files[@]}" -gt 0 ] && git_args+=(-- "${files[@]}")
    fi
    git "${git_args[@]}"
    ;;
  apply)
    [ -z "$stash_ref" ] && stash_ref="stash@{0}"
    git stash apply "$stash_ref"
    ;;
  drop)
    if [ -z "$stash_ref" ]; then
      echo "stash drop: stash_ref is required (e.g. stash@{0})" >&2
      exit 2
    fi
    git stash drop "$stash_ref"
    ;;
  "")
    echo "stash: subcommand is required (save|apply|drop)" >&2
    exit 2
    ;;
  *)
    echo "stash: unknown subcommand '$subcommand' (want save|apply|drop)" >&2
    exit 2
    ;;
esac
