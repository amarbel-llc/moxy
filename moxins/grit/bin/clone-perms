#!/usr/bin/env bash
# Dynamic-perms gate for grit.clone.
# Receives: $1 = destination path.
#
# The destination is judged by folio's write rule itself (folio-perms, moxy#535):
# allow inside CWD or the Claude write-allow dirs, refuse /nix/store, prompt
# elsewhere. The source (a local path or remote URL) is read-only and is not
# gated here.
#
# Exit codes (per moxy native dynamic-perms contract):
#   0 = allow
#   1 = ask
#   2 = deny
set -euo pipefail

destination="${1:-}"
if [ -z "$destination" ]; then
  echo "clone-perms: destination required — confirmation required"
  exit 1
fi

exec "@FOLIO_PERMS@" write "$destination"
